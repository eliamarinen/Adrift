+IN_PROC_BROWSER_TEST_F(VerticalTabStripRegionViewTest, SidebarUrlBarLayout) {
+  auto* view = BrowserView::GetBrowserViewForBrowser(browser());
+  auto* pref_service = browser()->GetProfile()->GetPrefs();
+  EXPECT_FALSE(pref_service->GetBoolean(prefs::kAdriftUrlBarInSidebar));
+  EXPECT_TRUE(view->IsToolbarVisible());
+
+  SetupExpandedVerticalTabStrip();
+  pref_service->SetBoolean(prefs::kAdriftUrlBarInSidebar, true);
+  RunScheduledLayouts();
+  EXPECT_FALSE(view->IsToolbarVisible());
+  ASSERT_TRUE(region_view()->FocusUrlField());
+  auto* field = views::AsViewClass<views::Textfield>(
+      view->GetFocusManager()->GetFocusedView());
+  ASSERT_TRUE(field);
+
+  for (int width : {160, 200, 320}) {
+    region_view()->OnResize(width - region_view()->width(), true);
+    RunScheduledLayouts();
+    const auto field_bounds = views::View::ConvertRectToTarget(
+        field, region_view(), field->GetLocalBounds());
+    EXPECT_GE(field_bounds.width(), region_view()->width() - 12);
+    EXPECT_LE(field_bounds.right(), region_view()->width());
+    EXPECT_FALSE(region_view()->IsPositionInWindowCaption(
+        field_bounds.CenterPoint()));
+    const auto strip_bounds = views::View::ConvertRectToTarget(
+        tab_strip_view(), region_view(), tab_strip_view()->GetLocalBounds());
+    EXPECT_GE(strip_bounds.y(), field_bounds.bottom());
+    EXPECT_GT(view->GetContentsSize().width(), 0);
+    EXPECT_GT(view->GetContentsSize().height(), 0);
+  }
+
+  state_controller()->RequestCollapse(true);
+  ASSERT_TRUE(base::test::RunUntil(
+      [&]() { return state_controller()->IsCollapsed(); }));
+  RunScheduledLayouts();
+  EXPECT_FALSE(field->IsDrawn());
+  EXPECT_FALSE(region_view()->FocusUrlField());
+  EXPECT_TRUE(view->IsToolbarVisible());
+
+  SetupExpandedVerticalTabStrip();
+  pref_service->SetBoolean(prefs::kAdriftUrlBarInSidebar, false);
+  RunScheduledLayouts();
+  EXPECT_FALSE(field->IsDrawn());
+  EXPECT_TRUE(view->IsToolbarVisible());
+}
+
+IN_PROC_BROWSER_TEST_F(VerticalTabStripRegionViewTest,
+                       SidebarUrlBarContentsOnStartup) {
+  browser()->GetProfile()->GetPrefs()->SetBoolean(prefs::kAdriftUrlBarInSidebar,
+                                                 true);
+  Browser* sidebar_browser = CreateBrowser(browser()->GetProfile());
+  ASSERT_TRUE(ui_test_utils::NavigateToURL(
+      sidebar_browser,
+      GURL("data:text/html,<title>Sidebar layout</title><h1>Visible page</h1>")));
+  auto* view = BrowserView::GetBrowserViewForBrowser(sidebar_browser);
+  EXPECT_FALSE(view->IsToolbarVisible());
+  EXPECT_GT(view->GetContentsSize().width(), 0);
+  EXPECT_GT(view->GetContentsSize().height(), 0);
+  EXPECT_TRUE(view->GetActiveWebContents()->GetRenderWidgetHostView());
+}
