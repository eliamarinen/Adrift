+void VerticalTabStripRegionView::DidFinishNavigation(
+    content::NavigationHandle* handle) {
+  if (handle->HasCommitted() && handle->IsInPrimaryMainFrame() &&
+      sidebar_url_field_) {
+    UpdateSidebarUrl();
+  }
+}
+
+void VerticalTabStripRegionView::UpdateSidebarUrl() {
+  if (!sidebar_url_field_) {
+    return;
+  }
+  auto* contents = web_contents();
+  sidebar_back_button_->SetEnabled(
+      contents && contents->GetController().CanGoBack());
+  sidebar_forward_button_->SetEnabled(
+      contents && contents->GetController().CanGoForward());
+  if (!sidebar_url_field_->HasFocus()) {
+    const auto url = contents ? base::UTF8ToUTF16(contents->GetVisibleURL().spec())
+                              : std::u16string();
+    sidebar_url_field_->SetText(url);
+    sidebar_url_field_->SetTooltipText(url);
+    sidebar_url_field_->SetSelectedRange(gfx::Range(0));
+  }
+}
+
+bool VerticalTabStripRegionView::HandleKeyEvent(
+    views::Textfield* sender,
+    const ui::KeyEvent& key_event) {
+  if (key_event.key_code() == ui::VKEY_ESCAPE &&
+      key_event.type() == ui::EventType::kKeyPressed) {
+    GetFocusManager()->ClearFocus();
+    UpdateSidebarUrl();
+    if (web_contents()) {
+      web_contents()->Focus();
+    }
+    return true;
+  }
+  if (key_event.key_code() != ui::VKEY_RETURN ||
+      key_event.type() != ui::EventType::kKeyPressed) {
+    return false;
+  }
+  const std::u16string input(sender->GetText());
+  if (input.empty()) {
+    return true;
+  }
+  GURL destination(base::UTF16ToUTF8(input));
+  const bool looks_like_host =
+      input.find_first_of(u" \t") == std::u16string::npos &&
+      (input.find(u".") != std::u16string::npos || input.starts_with(u"localhost"));
+  if (!destination.is_valid() || !destination.has_scheme()) {
+    if (!looks_like_host) {
+      auto* service = TemplateURLServiceFactory::GetForProfile(
+          browser_view()->browser()->GetProfile());
+      const TemplateURL* provider =
+          service ? service->GetDefaultSearchProvider() : nullptr;
+      if (!provider) {
+        return true;
+      }
+      destination =
+          provider->GenerateSearchURL(service->search_terms_data(), input);
+    } else {
+      destination = GURL("https://" + base::UTF16ToUTF8(input));
+    }
+  }
+  if (destination.is_valid() && browser_view()->GetActiveWebContents()) {
+    browser_view()->GetActiveWebContents()->GetController().LoadURL(
+        destination, content::Referrer(), ui::PAGE_TRANSITION_TYPED,
+        std::string());
+    GetFocusManager()->ClearFocus();
+    browser_view()->GetActiveWebContents()->Focus();
+  }
+  return true;
+}
+
+bool VerticalTabStripRegionView::FocusUrlField() {
+  if (!sidebar_url_field_ || !sidebar_url_field_->IsDrawn()) {
+    return false;
+  }
+  UpdateSidebarUrl();
+  sidebar_url_field_->RequestFocus();
+  sidebar_url_field_->SelectAll(false);
+  return true;
+}
+
 BEGIN_METADATA(VerticalTabStripRegionView)
 END_METADATA
