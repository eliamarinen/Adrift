 void HeliumLayoutStateController::SetBrowserLayout(HeliumLayoutType layout) {
+  // Adrift exposes no horizontal layout surfaces. Keep the pref stable even if
+  // an old command or profile attempts to select another layout.
+  if (layout != HeliumLayoutType::kVertical) {
+    return;
+  }
   pref_service_->SetInteger(prefs::kHeliumLayout, std::to_underlying(layout));
 }
 
